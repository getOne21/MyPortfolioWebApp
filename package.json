{
  "name": "portfolio",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --watch=false",
    "lint": "ng lint",
    "format": "prettier --write \"src/**/*.{ts,html,scss}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss}\""
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "22.2.4",
    "@angular/cdk": "22.2.5",
    "@angular/common": "22.2.4",
    "@angular/compiler": "22.2.4",
    "@angular/core": "22.2.4",
    "@angular/forms": "22.2.4",
    "@angular/material": "22.2.5",
    "@angular/platform-browser": "22.2.4",
    "@angular/platform-server": "22.2.4",
    "@angular/router": "22.2.4",
    "@angular/ssr": "22.2.5",
    "@fontsource/inter": "5.3.0",
    "@fontsource/material-icons": "5.3.0",
    "@fontsource/roboto": "5.3.0",
    "rxjs": "7.8.2",
    "simple-icons": "16.36.0",
    "tslib": "2.8.1",
    "zone.js": "0.16.3"
  },
  "devDependencies": {
    "@angular/build": "22.2.5",
    "@angular/cli": "22.2.5",
    "@angular/compiler-cli": "22.2.4",
    "@eslint/js": "10.0.1",
    "angular-eslint": "22.6.0",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  },
  "overrides": {
    "minimatch": "11.0.3",
    "vite": "8.3.5"
  }
}
